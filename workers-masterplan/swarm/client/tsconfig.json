{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "incremental": true,
    "preserveSymlinks": true,
    "plugins": [{ "name": "next" }],
    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["next-env.d.ts", "src/coordinator/**/*.ts", "src/coordinator/**/*.tsx", "src/app/**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
