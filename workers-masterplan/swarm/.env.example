# Copy this file to .env, enter local secrets there, then run: chmod 600 .env
SWARM_HOST=0.0.0.0
SWARM_PORT=4310
# The terminal controller always uses SWARM_PORT + 1.
SWARM_TIMEZONE=Asia/Singapore
# Display name for the controller's checkout. Defaults to the macOS user running Swarm.
SWARM_LOCAL_ACCOUNT=claudiothe

# Web coordinator login
SWARM_LOGIN_EMAIL=
SWARM_LOGIN_PASSWORD_HASH=
SWARM_TOTP_SECRET=
SWARM_SESSION_SECRET=

# Scheduling and authoritative production seed. Do not use example-ready.json here.
SWARM_MASTERPLAN_PATH=manifests/mvp3.json
# Default assumes Swarm runs from workers-masterplan/swarm inside this checkout.
SWARM_COORDINATION_ROOT=../..
# HTTPS clone source used only when a new isolated secondary profile is added.
SWARM_REPOSITORY_URL=https://github.com/theboi/EdenMind.git

# Use the exact Codex runtime bundled with the installed desktop app so both
# clients read and write the same rollout/state schema.
SWARM_CODEX_BIN=/Applications/ChatGPT.app/Contents/Resources/codex

# Bot macOS credentials. Keep these chmod-600 .env values local only.
# Each password belongs to the physical bot user and is used only at the su prompt;
# it is not a Codex/ChatGPT password and no profile credential belongs in this file.
# SWARM_USER1=bot1:password
# SWARM_USER2=bot2:password
# SWARM_USER3=bot3:password
# SWARM_USER4=bot4:password
# SWARM_USER5=bot5:password
# SWARM_USER6=bot6:password
# SWARM_USER7=bot7:password
# SWARM_USER8=bot8:password
